# Extension-only build on top of the current official PHP image (no core compile).
# Uses mlocati/docker-php-extension-installer, which resolves the apk build deps
# itself instead of hand-maintaining a package list.
ARG BASE=php:8.5-fpm-alpine
FROM ${BASE}

# Sumber setiap sambungan. Lalai = tag keluaran terkini (laluan produksi 8.5).
# PHP 8.6 pra-GA memerlukan cabang pembangunan yang belum ditag, jadi workflow
# menghantar REF khusus untuk versi itu. Setiap REF boleh jadi tag, cabang, atau
# SHA commit — refs/heads/... dan refs/tags/... diselesaikan oleh GitHub.
ARG APCU_REF=v5.1.28
ARG REDIS_REF=6.3.0
ARG MSGPACK_REF=v3.0.1
ARG IMAGICK_REF=3.8.1
ARG IGBINARY_REF=2b1f5d62e3037b07c2a46499ac32091cdb41fb40

COPY --from=mlocati/php-extension-installer:latest /usr/bin/install-php-extensions /usr/local/bin/

# pecl.php.net is unreachable from this network, so the PECL extensions are
# compiled from their GitHub tags. Explicit steps: a shell function hid the
# failing command behind redirects.
RUN set -eux; \
    apk add --no-cache --virtual .extbuild $PHPIZE_DEPS imagemagick-dev libc-dev \
 && mkdir -p /tmp/b/apcu \
 && wget -qO- "https://github.com/krakjoe/apcu/archive/${APCU_REF}.tar.gz" | tar xz -C /tmp/b/apcu --strip-components=1 \
 && cd /tmp/b/apcu \
 && phpize \
 && ./configure --with-php-config=/usr/local/bin/php-config --enable-apcu \
 && make -j"$(nproc)" \
 && make install \
 && docker-php-ext-enable apcu \
 && cd / && rm -rf /tmp/b/apcu \
 && mkdir -p /tmp/b/redis \
 && wget -qO- "https://github.com/phpredis/phpredis/archive/${REDIS_REF}.tar.gz" | tar xz -C /tmp/b/redis --strip-components=1 \
 && cd /tmp/b/redis \
 && phpize \
 && ./configure --with-php-config=/usr/local/bin/php-config \
 && make -j"$(nproc)" \
 && make install \
 && docker-php-ext-enable redis \
 && cd / && rm -rf /tmp/b/redis \
 && mkdir -p /tmp/b/msgpack \
 && wget -qO- "https://github.com/msgpack/msgpack-php/archive/${MSGPACK_REF}.tar.gz" | tar xz -C /tmp/b/msgpack --strip-components=1 \
 && cd /tmp/b/msgpack \
 && phpize \
 && ./configure --with-php-config=/usr/local/bin/php-config \
 && make -j"$(nproc)" \
 && make install \
 && docker-php-ext-enable msgpack \
 && cd / && rm -rf /tmp/b/msgpack \
 && mkdir -p /tmp/b/imagick \
 && wget -qO- "https://github.com/Imagick/imagick/archive/${IMAGICK_REF}.tar.gz" | tar xz -C /tmp/b/imagick --strip-components=1 \
 && cd /tmp/b/imagick \
 && phpize \
 && ./configure --with-php-config=/usr/local/bin/php-config --with-imagick \
 && make -j"$(nproc)" \
 && make install \
 && docker-php-ext-enable imagick \
 && cd / && rm -rf /tmp/b/imagick \
 && mkdir -p /tmp/b/igbinary \
 && wget -qO- "https://github.com/igbinary/igbinary/archive/${IGBINARY_REF}.tar.gz" | tar xz -C /tmp/b/igbinary --strip-components=1 \
 && cd /tmp/b/igbinary \
 && phpize \
 && ./configure --with-php-config=/usr/local/bin/php-config \
 && make -j"$(nproc)" \
 && make install \
 && docker-php-ext-enable igbinary \
 && cd / && rm -rf /tmp/b/igbinary \
 && apk del .extbuild \
 && php -m | tr '\n' ' '

# The official 8.6 RC base images ship a leaner module set than 8.5: mbstring, soap, xsl,
# sockets, pcntl, shmop, sysvsem, calendar, gettext, gmp, ldap, pdo_pgsql and igbinary are all
# absent. WordPress survives without them, plugins do not (mb_strtolower() in a mu-plugin was
# an immediate fatal). Installing the full set is a no-op on the 8.5 base, so the list stays
# identical for every version.
RUN install-php-extensions pdo_mysql mysqli gd intl zip exif bcmath opcache \
      mbstring soap xsl sockets pcntl shmop sysvsem calendar gettext gmp ldap pdo_pgsql

# wp-cli: cron runners and the panel call `wp cron event run`
RUN wget -qO /usr/local/bin/wp-cli.phar https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
 && printf '#!/bin/sh\nexec php -d error_reporting="E_ALL & ~E_DEPRECATED" /usr/local/bin/wp-cli.phar "$@"\n' > /usr/local/bin/wp \
 && chmod +x /usr/local/bin/wp /usr/local/bin/wp-cli.phar \
 && wp --info --allow-root >/dev/null && echo wp-cli-ok

# The fleet mounts each site's pool config as zz-docker.conf, but the image's own
# www.conf (listen = 9000) wins the merge, so nginx never finds the socket.
# Ship the fleet convention instead and drop the conflicting default.
RUN rm -f /usr/local/etc/php-fpm.d/www.conf /usr/local/etc/php-fpm.d/www.conf.default \
 && printf '[www]\nlisten = /run/php-fpm/fpm-www.sock\nlisten.mode = 0660\npm = dynamic\npm.max_children = 5\npm.start_servers = 2\npm.min_spare_servers = 1\npm.max_spare_servers = 3\npm.process_idle_timeout = 10s\n' > /usr/local/etc/php-fpm.d/zzz-www.conf \
 && php-fpm -t 2>&1 | tail -1

# ghostscript backs Imagick's PDF/PS delegate (WordPress PDF previews)
RUN apk add --no-cache ghostscript imagemagick msmtp \
 && gs --version \
 && php -r 'echo "BUILT " . PHP_VERSION . "\n";' \
 && php -m | tr '\n' ' '
